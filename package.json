{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-content-placeholders.mjs && node scripts/generate-sw.mjs && next build",
    "start": "next start",
    "test:articles": "node --import ./scripts/register-ts-resolve.mjs --test scripts/test-articles.mjs",
    "test:search": "node --import ./scripts/register-ts-resolve.mjs --test scripts/test-search.mjs",
    "test:notifications": "node --import ./scripts/register-ts-resolve.mjs --test scripts/test-notifications.mjs",
    "test:consultations": "node --import ./scripts/register-ts-resolve.mjs --test scripts/test-consultations.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import ./scripts/register-ts-resolve.mjs --test scripts/test-*.mjs tests/unit/*.test.mjs",
    "test:integration": "node --import ./scripts/register-ts-resolve.mjs --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:stack:up": "node tests/support/stack/stack.mjs up",
    "test:stack:down": "node tests/support/stack/stack.mjs down",
    "test:stack:status": "node tests/support/stack/stack.mjs status",
    "test:stack:reset": "node tests/support/stack/stack.mjs reset",
    "test:stack:build": "node tests/support/stack/stack.mjs build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=65",
    "check:content": "node scripts/check-content-placeholders.mjs",
    "check:audit": "node scripts/audit-gate.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:content && npm run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@base-ui/react": "^1.5.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@supabase/postgrest-js": "^2.118.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "next-intl": "^4.14.4",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "postcss": "^8.5",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
