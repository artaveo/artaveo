# Roadmap § 9.2 — Server handling & persistence.
#
# D-10 is resolved: the live `Artaveo` Supabase project exists
# (ukzovqnpqjcrwofycalc, ap-southeast-1, free plan). SUPABASE_URL below
# is filled in since it's public info; SUPABASE_SERVICE_ROLE_KEY is left
# blank on purpose — copy it yourself from the Supabase dashboard
# (Settings → API → service_role) into your own .env.local (already
# gitignored). Never commit the real value — it bypasses Row Level
# Security entirely.

# Roadmap § 11.1 (SEO) / D-01 (production domain).
#
# Controls the canonical URL, hreflang, OpenGraph/Twitter tags, and
# sitemap.xml entries (lib/seo.ts#SITE_URL). Left unset today: falls back
# to the interim Vercel URL (https://artaveo-seven.vercel.app), which is
# what D-01's "confirmed interim domain" default already documents in
# ROAD-MAP-ARTAVEO.md. Set this in Vercel — no code change needed — once
# the real domain is bought and DNS-authenticated (D-01), same pattern as
# the EMAIL_PROVIDER switch below.
#
# NEXT_PUBLIC_SITE_URL=https://artaveo.dev

SUPABASE_URL=https://ukzovqnpqjcrwofycalc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Roadmap § 13 — Admin Authentication & Authorization.
#
# The `anon` key (Settings → API → anon/public). Unlike
# SUPABASE_SERVICE_ROLE_KEY above, this one is safe to be public — it is
# the key `@supabase/ssr`'s cookie-bound client uses for the admin
# sign-in/session flow (`lib/supabase/server-auth.ts`, `proxy.ts`), so
# every admin request is authorized as the signed-in user and subject to
# RLS, never as service-role. Every admin auth call happens in a Server
# Action or middleware, so this is never sent to the browser as a
# NEXT_PUBLIC_ var — no anon-key client exists there.
SUPABASE_ANON_KEY=

# Salts the IP hash stored with inquiries and every rate-limit key (§ 9.2:
# "without extra personal data" — the raw IP itself is never stored). A random
# string of 16+ characters (`openssl rand -hex 32`); rotate it and old hashes
# and rate-limit windows simply stop matching, which is fine. If unset (Phase
# 23), a key derived one-way from SUPABASE_SERVICE_ROLE_KEY is used instead —
# set your own to make it independent. See docs/security.md § 6.
INQUIRY_IP_HASH_SECRET=

# Roadmap § 9.3 / Phase 19 — Notifications & Outbox.
#
# D-01 (production domain + SPF/DKIM/DMARC) is still open, so real
# sending is OFF by default: leave EMAIL_PROVIDER unset (or 'console') and
# every notification is logged instead of sent, while still going through
# the full outbox / retry / delivery-log pipeline honestly (the admin
# notifications page says "logged only — not delivered"). Once the real
# domain is bought and DNS-authenticated (D-01), set all three of the
# following to switch on real sending — no code change needed:
#
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=<from the Resend dashboard>
#   EMAIL_FROM_ADDRESS=<an address on the authenticated domain, e.g. Artaveo <hello@artaveo.dev>>
#
# A key alone never activates sending, and a half-configured resend setup
# falls back to the console provider — the admin page shows a warning.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# CRON_SECRET guards the daily run (/api/cron/notifications: notification
# retries, scheduled article publishing, publish notices).
#
# CORRECTED in Phase 19: Vercel does NOT create this for you. It sends
# `Authorization: Bearer $CRON_SECRET` on its scheduled calls only when YOU
# add an environment variable with this name to the Vercel project (Settings
# → Environment Variables), then redeploy. The route now REFUSES to run
# without it (401) — it used to run open when the variable was missing.
# Use a random string of at least 16 characters, e.g. `openssl rand -hex 32`.
#
# Locally, set it only if you want to call the route by hand:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/notifications
CRON_SECRET=

# Phase 23 — Content Security Policy escape hatch. Set to 1 (in Vercel, then
# redeploy) ONLY if a legitimate resource is being blocked in production: the
# policy then reports violations in the browser console instead of blocking.
# The server logs a warning at start-up while it is set. Leave unset.
# CSP_REPORT_ONLY=
